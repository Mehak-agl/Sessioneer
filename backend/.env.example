# Copy to backend/.env and fill in your own values. Never commit .env.
# Get DB_URL / DB_USERNAME / DB_PASSWORD from your Neon project -> Connection Details.
DB_URL=jdbc:postgresql://ep-xxx-xxx.region.aws.neon.tech/sessioneer?sslmode=require
DB_USERNAME=your-neon-username
DB_PASSWORD=your-neon-password
JWT_SECRET=any-long-random-string
